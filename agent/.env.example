# Copy to .agent_env on the DO box and fill in. Referenced by the
# sigrepo-agent service in docker-compose-vm.yml (env_file).

# Required: the Anthropic API key the agent bills against.
ANTHROPIC_API_KEY=sk-ant-...

# Recommended: shared secret required in the X-Agent-Token header on /run.
# Generate one with:  openssl rand -hex 24
AGENT_TOKEN=

# Optional overrides (defaults shown).
# AGENT_SKILLS_CWD=/SigRepo
# AGENT_SKILLS=all
# AGENT_PERMISSION_MODE=bypassPermissions
